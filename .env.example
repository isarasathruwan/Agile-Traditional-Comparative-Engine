# Docker Deployment Environment Variables
# Copy this file to .env and update the values as needed.

# --- Backend Security ---
# Change this to a strong random secret in production!
JWT_SECRET=change-me-please-change-me

# --- CORS ---
# Comma-separated list of origins allowed to call the backend API.
# When using the Nginx setup, this should include the Nginx origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# --- Frontend API URL ---
# URL the frontend browser will use to reach the backend.
# For the simple 3-service setup (docker-compose.yml only):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For the Nginx production setup (docker-compose.nginx.yml):
#   NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public draft upload endpoints remain unauthenticated for the assessment flow.
AUTH_WHITELIST_PATHS=/health,/docs,/openapi.json,/api/v1/admin/login,/api/v1/assessments,/api/v1/questionnaire,/api/v1/assessment-drafts

# Persistent document storage directory inside the backend container.
# Keep this aligned with the Docker volume mount unless you intentionally customize it.
ASSESSMENT_DOCUMENTS_DIR=/var/lib/methodalign/documents

# Required for encrypted document storage. Generate once with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DOCUMENT_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
DOCUMENT_ENCRYPTION_KEY_VERSION=v1
PARTICIPANT_COOKIE_SECURE=false

# Google AI Studio document processing
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_WORKER_RETRY_LIMIT=3
TRADITIONAL_ADVISOR_WORKER_POLL_SECONDS=2
TRADITIONAL_ADVISOR_RETRY_LIMIT=3
