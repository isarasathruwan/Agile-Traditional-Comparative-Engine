APP_NAME="MethodAlign IS API"
APP_ENV=local
APP_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=methodalign
POSTGRES_DRIVER=psycopg

JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=480

AUTH_WHITELIST_PATHS=/health,/docs,/openapi.json,/api/v1/admin/login,/api/v1/assessments,/api/v1/questionnaire,/api/v1/assessment-drafts
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
ASSESSMENT_DOCUMENTS_DIR=/var/lib/methodalign/documents

# Required for encrypted document storage. Generate once with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DOCUMENT_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
DOCUMENT_ENCRYPTION_KEY_VERSION=v1
PARTICIPANT_COOKIE_SECURE=false

# Google AI Studio document processing
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_WORKER_RETRY_LIMIT=3
TRADITIONAL_ADVISOR_WORKER_POLL_SECONDS=2
TRADITIONAL_ADVISOR_RETRY_LIMIT=3
PDF_MIN_EXTRACTED_CHARACTERS=200
